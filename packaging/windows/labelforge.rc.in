// SPDX-License-Identifier: GPL-3.0-or-later
// Configured by CMake into the build directory (version from LABELFORGE_VERSION).
#include <winver.h>

IDI_ICON1 ICON "@LF_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @LF_VER_MAJOR@,@LF_VER_MINOR@,@LF_VER_PATCH@,0
 PRODUCTVERSION @LF_VER_MAJOR@,@LF_VER_MINOR@,@LF_VER_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LabelForge contributors"
            VALUE "FileDescription", "LabelForge label designer"
            VALUE "FileVersion", "@LABELFORGE_VERSION@"
            VALUE "InternalName", "LabelForge"
            VALUE "LegalCopyright", "GNU GPL v3 or later"
            VALUE "OriginalFilename", "LabelForge.exe"
            VALUE "ProductName", "LabelForge"
            VALUE "ProductVersion", "@LABELFORGE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
